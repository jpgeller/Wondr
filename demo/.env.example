# Names only. Real values go in .env.local (git-ignored) and in Vercel env vars.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (B)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth, same client as the Supabase Google provider; needed server-side to refresh calendar tokens (B)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Agent (A). real = the agent, mock = canned plan with fake progress, seed = pre-tested demo plan
AGENT_MODE=mock

# Model, only read by lib/llm.ts (A). omnara or anthropic
LLM_PROVIDER=omnara
OMNARA_API_KEY=
OMNARA_BASE_URL=
LLM_MODEL=
# Fallback if Omnara credits are late
ANTHROPIC_API_KEY=

# Venue discovery (A)
EXA_API_KEY=
CONTEXT_DEV_API_KEY=

# Booking (A). Keep dry run on until we test on real venues on purpose.
BOOKING_DRY_RUN=true
RESEND_API_KEY=
RESEND_FROM_EMAIL=
